# ==============================================================================
# TTS-ar: Configuración de Entorno y Docker Compose
# ==============================================================================

# Puerto expuesto en el host para pruebas y frontend (http://localhost:8001)
TTS_HOST_PORT=8001

# Red externa de Docker compartida con MedSim
# Por defecto el proyecto MedSim crea la red 'medsim_medsim_net'
MEDSIM_NETWORK=medsim_medsim_net

# Nivel de logging (debug, info, warning, error)
LOG_LEVEL=info
